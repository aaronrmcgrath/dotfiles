#!/usr/bin/env bash
# Compiles ~/.ai/ sources into vendor-specific outputs.
# Targets: agents-md (~/AGENTS.md), skills (SKILL.md per domain), mcp (~/.claude/settings.json)
# Usage: compile-ai-config [--target=all|agents-md|skills|symlinks|mcp]

set -euo pipefail

AI_DIR="$HOME/.ai"
TARGET="${1:-}"
TARGET="${TARGET#--target=}"
TARGET="${TARGET:-all}"

# ── ~/AGENTS.md ────────────────────────────────────────────────────────────────

build_agents_md() {
  local out="$HOME/AGENTS.md"
  {
    echo "# AGENTS — Global AI Config"
    echo "# Generated by compile-ai-config on $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "# Source: ~/.ai/  |  Do not edit directly."
    echo ""

    for src in init.md user.md machine.md; do
      local f="$AI_DIR/$src"
      [[ -f "$f" ]] || continue
      echo ""
      echo "---"
      echo "<!-- source: ~/.ai/$src -->"
      cat "$f"
    done

    # Skills
    for f in "$AI_DIR"/skills/domains/*.md; do
      [[ -f "$f" ]] || continue
      echo ""
      echo "---"
      echo "<!-- source: ~/.ai/skills/domains/$(basename "$f") -->"
      cat "$f"
    done

    # Agents
    for f in "$AI_DIR"/agents/*.md; do
      [[ -f "$f" ]] || continue
      echo ""
      echo "---"
      echo "<!-- source: ~/.ai/agents/$(basename "$f") -->"
      cat "$f"
    done
  } > "$out"

  echo "Wrote $out"
}

# ── ~/.claude/skills/<name>/SKILL.md ──────────────────────────────────────────

build_skills() {
  local skills_dir="$AI_DIR/skills/domains"
  [[ -d "$skills_dir" ]] || { echo "No skills/domains directory found"; return; }

  for src in "$skills_dir"/*.md; do
    [[ -f "$src" ]] || continue
    local name
    name=$(basename "$src" .md)
    local dest_dir="$HOME/.claude/skills/$name"
    local dest="$dest_dir/SKILL.md"

    mkdir -p "$dest_dir"

    # Extract first H1 as description fallback
    local description
    description=$(grep -m1 '^# ' "$src" | sed 's/^# //' || echo "$name skill")

    {
      echo "---"
      echo "name: $name"
      echo "description: $description"
      echo "generated: $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      echo "source: ~/.ai/skills/domains/$name.md"
      echo "---"
      echo ""
      cat "$src"
    } > "$dest"

    echo "Wrote $dest"
  done
}

# ── MCP servers → ~/.claude/settings.json ─────────────────────────────────────

build_mcp() {
  local src="$AI_DIR/mcp/servers.json"
  local dest="$HOME/.claude/settings.json"

  [[ -f "$src" ]] || { echo "No mcp/servers.json found"; return; }

  local mcp_block
  mcp_block=$(jq '
    .servers | map({key: .name, value: {command: .command, args: .args, env: (.env // {})}}) | from_entries
  ' "$src")

  local current="{}"
  [[ -f "$dest" ]] && current=$(cat "$dest")

  echo "$current" | jq --argjson mcp "$mcp_block" '. + {mcpServers: $mcp}' > "$dest"
  echo "Wrote mcpServers to $dest"
}

# ── Symlinks ───────────────────────────────────────────────────────────────────

build_symlinks() {
  local agents_src="$AI_DIR/agents"
  local agents_dst="$HOME/.claude/agents"
  local commands_src="$AI_DIR/commands"
  local commands_dst="$HOME/.claude/commands"

  mkdir -p "$agents_dst" "$commands_dst"

  for f in "$agents_src"/*.md; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f")
    local link="$agents_dst/$name"
    ln -sf "$f" "$link"
    echo "Linked $link -> $f"
  done

  for f in "$commands_src"/*.md; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f")
    local link="$commands_dst/$name"
    ln -sf "$f" "$link"
    echo "Linked $link -> $f"
  done
}

# ── Dispatch ───────────────────────────────────────────────────────────────────

case "$TARGET" in
  all)
    build_agents_md
    build_skills
    build_symlinks
    build_mcp
    ;;
  agents-md)
    build_agents_md
    ;;
  skills)
    build_skills
    ;;
  symlinks)
    build_symlinks
    ;;
  mcp)
    build_mcp
    ;;
  *)
    echo "Unknown target: $TARGET"
    echo "Usage: compile-ai-config [--target=all|agents-md|skills|symlinks]"
    exit 1
    ;;
esac

echo "Done."
